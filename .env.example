# Application origin for authentication redirects and metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase authentication client configuration
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Supabase server-only secret
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# RecruitOS AI
GROQ_API_KEY=YOUR_GROQ_API_KEY

# Paddle Billing - Phase 3C is sandbox-only
PADDLE_ENVIRONMENT=sandbox
NEXT_PUBLIC_PADDLE_ENVIRONMENT=sandbox
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=YOUR_PADDLE_SANDBOX_CLIENT_SIDE_TOKEN
PADDLE_API_KEY=YOUR_PADDLE_SANDBOX_API_KEY
PADDLE_WEBHOOK_SECRET=YOUR_PADDLE_SANDBOX_WEBHOOK_SECRET
PADDLE_STANDARD_PRICE_ID=pri_01m28215ary5fh2qytj8trz20h
PADDLE_PRO_PRICE_ID=pri_01m281z24xke9jjs4v5zq5tsz1

# Optional consent-gated launch analytics. Public PROJECT ingestion token only; never a personal API key.
# Configure in both Vercel Preview and Production. US Cloud; session replay stays disabled.
NEXT_PUBLIC_POSTHOG_KEY=YOUR_POSTHOG_KEY
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
